[submodule "e"]
	path = e
	url = https://github.com/gravitational/teleport.e.git
# maestra: upstream's public tree carries the `e` (enterprise) gitlink with no
# .gitmodules. actions/checkout with persist-credentials: false runs
# `git submodule foreach` and dies on it; this entry lets foreach skip the
# uninitialized submodule. Nothing clones it (the URL is private).
